{
  "name": "effect-boundaries-demo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "boundaries": "turbo boundaries",
    "install:all": "bun install && bun --cwd nx install && bun --cwd turborepo install",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "nx": "24.0.4",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
